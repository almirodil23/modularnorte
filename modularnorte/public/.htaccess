Options -MultiViews -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteBase /

# ---------------------------------------------------------
# Evita que los HTML generados sean URLs duplicadas públicas
# ---------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# ---------------------------------------------------------
# Redirecciones SEO permanentes desde las URLs antiguas
# ---------------------------------------------------------
RewriteRule ^projects/?$ /proyectos/ [R=301,L,NE]
RewriteRule ^producto/(.+?)/?$ /proyecto/$1 [R=301,L,NE]
RewriteRule ^blogs/?$ /blog/ [R=301,L,NE]
RewriteRule ^blogs/(.+?)/?$ /blog/$1 [R=301,L,NE]
RewriteRule ^privacy/?$ /politica-privacidad [R=301,L,NE]

# ---------------------------------------------------------
# Una única variante por URL
# ---------------------------------------------------------
# /blog/ y /proyectos/ son directorios reales con index.html.
RewriteRule ^(blog|proyectos)$ /$1/ [R=301,L,NE]

# El resto de páginas canónicas no lleva barra final.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# ---------------------------------------------------------
# HTML SEO generado: /contactar -> /contactar.html
# y /proyecto/slug -> /proyecto/slug.html
# ---------------------------------------------------------
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ---------------------------------------------------------
# Archivos y carpetas reales (assets, imágenes, sitemap...)
# ---------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------------------------------------------------------
# 404 real para evitar soft-404 indexables
# ---------------------------------------------------------
ErrorDocument 404 /404.html
RewriteRule ^ - [R=404,L]
